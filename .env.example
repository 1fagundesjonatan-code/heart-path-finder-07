# Copie para .env (ignorado pelo git). Nunca commite valores reais.

# Publicas: vao para o bundle do navegador. Protegidas por RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# SEGREDO: somente servidor. Sem prefixo VITE_. Em producao, configure como
# env do projeto na Vercel (painel), nunca em arquivo versionado.
SUPABASE_SERVICE_ROLE_KEY=

# IA (somente servidor, sem prefixo VITE_). Chave da OpenAI usada pelo agente The Self AI.
OPENAI_API_KEY=
# Modelo padrao de novas versoes do agente (lista permitida em src/integrations/ai/models.ts).
AI_DEFAULT_CHAT_MODEL=gpt-5.4-mini
# Limite de mensagens por usuario por dia (padrao 50 no codigo).
AI_DAILY_MESSAGE_LIMIT=

# Destino do link do e-mail de convite de profissional (opcional; padrao: <origem>/aceitar-convite).
PROFESSIONAL_INVITE_REDIRECT_URL=
